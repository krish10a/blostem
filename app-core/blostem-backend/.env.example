# Database
# For Production (Supabase): postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Supabase Auth
# Required for ES256 JWT verification
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# AI Services (Gemini Rotation)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4

# Groq Fallback (High Speed)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI Fallback (Local Ollama)
# Set to 'true' to allow fallback to a local Ollama instance if all Gemini keys fail
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma:2b
